# Copy this file to .env and fill in your own values.
# .env is git-ignored; never commit real credentials.

# API base URL and workspace
INNORIX_BASE_URL=https://app.innorix.com
INNORIX_WORKSPACE_ID=<WORKSPACE_ID>

# Account credentials
INNORIX_EMAIL=<YOUR_EMAIL>
INNORIX_PASSWORD=<YOUR_PASSWORD>

# Transfer source/target device IDs (see: GET /api/device)
INNORIX_SOURCE_ID=<SOURCE_DEVICE_ID>
INNORIX_TARGET_ID=<TARGET_DEVICE_ID>

# Target save path (absolute, on the target device; use forward slashes)
INNORIX_TARGET_PATH=C:/Users/innorix/Downloads

# Source file/folder paths (absolute, on the source device; comma-separated)
INNORIX_SOURCE_PATHS=C:/Users/innorix/Downloads/image

# Optional: whether each source path is a directory (comma-separated true/false,
# aligned with INNORIX_SOURCE_PATHS). Missing entries default to false.
# Used by the automation example (07) to set sourceItem[].isDir.
INNORIX_SOURCE_IS_DIR=false
